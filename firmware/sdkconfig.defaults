CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash, custom partition table (3 MB app)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM on the N16R8 — holds the record and playback buffers
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LWIP_SO_RCVBUF=y

# HTTPS to the Cloudflare Worker: keep TLS buffers in PSRAM, so internal RAM
# stays free for Wi-Fi and the audio DMA buffers.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Faster, steadier downloads of reply audio: a 32 KB TCP window instead of
# 5.7 KB. Wi-Fi buffers stay in internal RAM: PSRAM mode needs more RX
# buffers than this project had, and the mismatch can stall downloads.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
